// Build settings shared by every target (attached under Project > Info > Configurations).

// Metal flags for precompiled Core Image kernels (Filters/Kernels.ci.metal).
MTL_COMPILER_FLAGS = -fcikernel
MTLLINKER_FLAGS = -fcikernel

// Xcode's App Intents metadata extractor reports "Metadata extraction skipped, no AppIntents.framework
// dependency found" as a build warning for any target that doesn't link AppIntents. This app has no App
// Intents, so it links the framework weakly just to satisfy that check (nothing from it is used).
OTHER_LDFLAGS = $(inherited) -weak_framework AppIntents
