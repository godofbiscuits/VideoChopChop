// Build settings shared by every target (attached under Project > Info > Configurations).

// Metal flags for precompiled Core Image kernels (Filters/Kernels.ci.metal).
MTL_COMPILER_FLAGS = -fcikernel
MTLLINKER_FLAGS = -fcikernel

// Xcode's App Intents metadata extractor warns "Metadata extraction skipped, no AppIntents.framework dependency
// found" for any target that doesn't link AppIntents. The app does (Intents/ExportAsImagesIntent.swift); the UI test
// bundle doesn't, so link it weakly everywhere to keep the build free of that warning.
OTHER_LDFLAGS = $(inherited) -weak_framework AppIntents
